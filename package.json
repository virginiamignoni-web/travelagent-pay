{
  "name": "travelagent-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Passenger recovery platform with agentic HTTP 402 payments and a Stellar-to-Pix voucher off-ramp.",
  "repository": {
    "type": "git",
    "url": "https://github.com/virginiamignoni-web/travelagent-pay.git"
  },
  "keywords": [
    "stellar",
    "mpp",
    "http-402",
    "agentic-payments",
    "usdc",
    "off-ramp",
    "pix",
    "passenger-recovery"
  ],
  "scripts": {
    "start": "node src/server.js",
    "start:stellar": "node scripts/start-stellar.js",
    "dev": "node --watch src/server.js",
    "setup:agent": "node scripts/setup-agent-wallet.js",
    "settle:vouchers:testnet": "node scripts/settle-pending-vouchers.js",
    "pay": "node src/client.js",
    "test": "node --test",
    "verify:bounty": "node scripts/verify-bounty.js",
    "verify:bounty:online": "node scripts/verify-bounty.js --online"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/mpp": "latest",
    "@stellar/stellar-sdk": "latest",
    "express": "latest",
    "mppx": "latest"
  }
}
