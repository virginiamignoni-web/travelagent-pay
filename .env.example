# local = synthetic 402 flow for UI development; stellar = real MPP Charge on testnet
PAYMENT_MODE=local
PORT=3001
MPP_SECRET_KEY=replace-with-a-long-random-value
STELLAR_RECIPIENT=G...SELLER_PUBLIC_KEY
STELLAR_SECRET=S...BUYER_TESTNET_SECRET
# Disposable Testnet-only treasury used for 0.01 USDC voucher issuance proofs.
# When omitted locally, the ignored .agent-wallet.env account is used.
VOUCHER_ISSUER_SECRET=S...TESTNET_AIRLINE_TREASURY_SECRET
VOUCHER_DEFAULT_RECIPIENT=G...TESTNET_TRAVELER_PUBLIC_KEY
DUFFEL_ACCESS_TOKEN=duffel_test_replace_me
AVIATIONSTACK_ACCESS_KEY=replace_with_new_aviationstack_key
