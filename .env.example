# local = synthetic 402 flow for UI development; stellar = real MPP Charge on testnet
PAYMENT_MODE=local
PORT=3001
MPP_SECRET_KEY=replace-with-a-long-random-value
STELLAR_RECIPIENT=G...SELLER_PUBLIC_KEY
STELLAR_SECRET=S...BUYER_TESTNET_SECRET
# Customer booking proofs are sent here before Duffel Test issuance.
BOOKING_TREASURY=G...BIT_TESTNET_TREASURY
BOOKING_TESTNET_PAYMENT_USDC=0.10
# Disposable Testnet-only treasury used to fund the full symbolic voucher value.
# When omitted locally, the ignored .agent-wallet.env account is used.
VOUCHER_ISSUER_SECRET=S...TESTNET_AIRLINE_TREASURY_SECRET
VOUCHER_DEFAULT_RECIPIENT=G...TESTNET_TRAVELER_PUBLIC_KEY
DUFFEL_ACCESS_TOKEN=duffel_test_replace_me
AVIATIONSTACK_ACCESS_KEY=replace_with_new_aviationstack_key
# Etherfuse FX sandbox. Keep the real key only in the ignored local .env file.
ETHERFUSE_API_KEY=api_sand:replace_me:organization_uuid
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com
ETHERFUSE_ORGANIZATION_ID=replace_with_sandbox_organization_uuid
ETHERFUSE_WALLET_ID=replace_with_registered_stellar_wallet_uuid
ETHERFUSE_PIX_BANK_ACCOUNT_ID=replace_with_sandbox_pix_bank_account_uuid
# Etherfuse currently accepts 1 USDC as the minimum tested USDC→BRL sandbox quote.
ETHERFUSE_REDEMPTION_USDC=1
